# Django ASGI / WebSockets reverse proxy template
#
# Usage:
#   1. Copy this file to conf.d/<your-domain>.conf
#   2. Replace ${DOMAIN_NAME}, ${CONTAINER_NAME}, and ${CONTAINER_PORT}
#   3. Ensure the app container is on the `gateway` network
#   4. Run ./scripts/reload-nginx.sh
#
# Example:
#   DOMAIN_NAME=api.example.com
#   CONTAINER_NAME=app-web
#   CONTAINER_PORT=8000

# ---------------------------------------------------------------------------
# HTTP — ACME challenge + redirect to HTTPS
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS — TLS termination and reverse proxy to the app container
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # Prefer modern TLS; adjust if you have legacy clients
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Global security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # WebSocket / ASGI long-lived connections (e.g. Django Channels)
    location /ws/ {
        proxy_pass http://${CONTAINER_NAME}:${CONTAINER_PORT};
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Standard HTTP / API traffic
    location / {
        proxy_pass http://${CONTAINER_NAME}:${CONTAINER_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Connection "";
    }
}
