# vps-deployment — environment placeholders
# Copy to .env in the relevant stack directory and fill in real values.
# Never commit a populated .env.

# --- Shared / DNS ---
DOMAIN_NAME=api.example.com

# --- Docker global-proxy / app upstream ---
CONTAINER_NAME=app-web
CONTAINER_PORT=8000

# --- Docker django-asgi app blueprint ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
GHCR_IMAGE=ghcr.io/YOUR_ORG/YOUR_APP

# --- VPS native django-asgi (silo example) ---
APP_NAME=silo
APP_ROOT=/var/www/silo
APP_DOMAIN=api.example.com
DATABASE_URL=postgres://silo:change-me@127.0.0.1:5432/silo
REDIS_URL_BARE=redis://127.0.0.1:6379/0
